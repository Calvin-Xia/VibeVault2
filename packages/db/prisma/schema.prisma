generator client {
  provider        = "prisma-client-js"
  // queryCompiler: 纯 TS 查询编译器,替代 Rust 引擎 —— Workers (OpenNext) 上唯一可行路线,
  // wasm 引擎变体在 OpenNext 中不被支持(opennextjs#139)。必须搭配驱动适配器使用。
  previewFeatures = ["driverAdapters", "queryCompiler"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  links         Link[]
  tags          Tag[]
  collections   Collection[]
  jobs          Job[]
}

model Link {
  id              String   @id @default(cuid())
  userId          String
  url             String
  normalizedUrl   String
  domain          String
  title           String?
  description     String?
  note            String?
  ogImage         String?
  favicon         String?
  siteName        String?
  publishedTime   DateTime?
  status          String   @default("INBOX")
  favorite        Boolean   @default(false)
  collectionId    String?
  metadataStatus  String   @default("PENDING")
  metadataError   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lastVisitedAt   DateTime?

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  collection     Collection?    @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  linkTags       LinkTag[]
  visits         LinkVisit[]

  @@unique([userId, url])
}

model Tag {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String?  @default("#8b5cf6")
  createdAt DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkTags   LinkTag[]

  @@unique([userId, name])
}

model LinkTag {
  linkId String
  tagId  String
  link   Link @relation(fields: [linkId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([linkId, tagId])
}

model Collection {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String?  @default("#3b82f6")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  links Link[]

  @@unique([userId, name])
}

model LinkVisit {
  id         String   @id @default(cuid())
  linkId     String
  visitedAt  DateTime @default(now())

  link       Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
}

model Job {
  id        String   @id @default(cuid())
  userId    String
  type      String
  payload   String
  status    String   @default("QUEUED")
  error     String?
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OTPVerification {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email])
}
